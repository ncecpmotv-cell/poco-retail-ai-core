#!/data/data/com.termux/files/usr/bin/bash
# termux-services (runit) entrypoint for the Retail AI daemon.
#
# INSTALL LOCATION (termux-services convention):
#   $PREFIX/var/service/retail-ai/run
# sv-enable/sv-disable toggle a `down` file next to it.
# IMPORTANT: restart the Termux session after installing termux-services so
# the runsvdir supervisor starts (sv fails without it).
# setup.sh installs this automatically.
#
# Enable/control with:
#   sv-enable retail-ai     # start on boot
#   sv up retail-ai         # start now
#   sv status retail-ai     # status
#   sv down retail-ai       # stop
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_DIR" || exit 1
exec "$REPO_DIR/.venv/bin/python" "$REPO_DIR/core/main.py" \
    >> "$REPO_DIR/logs/service.log" 2>&1
