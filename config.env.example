# =============================================================================
# Retail AI Core — configuration template.
# Copy to `config.env` and fill in your values. NEVER commit config.env.
# All values can be overridden by real environment variables.
# =============================================================================

# --- Telegram bridge ---------------------------------------------------------
# Bot token from @BotFather (used for the channel-bus and getUpdates).
BOT_TOKEN=your_bot_token_here
# Private state channel: numeric id (e.g. -1001234567890) or @username.
# The bot must be admin of this channel with "Post messages" + "Pin messages".
STATE_CHANNEL_ID=@your_state_channel
# Telegram numeric ids. ADMIN_ID may manage subscriptions; USER_ID is the owner.
ADMIN_ID=0
USER_ID=0

# --- Security & alerts ---------------------------------------------------------
# Optional HMAC key shared with the dashboard (enter the same value in the
# dashboard Settings). Empty = unsigned envelopes accepted (zero-config mode).
BRIDGE_SECRET=
# Chat alerts (Critical congestion / new staffing gaps) go to ALERT_CHAT_ID
# (defaults to USER_ID when 0).
ALERT_ENABLED=true
ALERT_CHAT_ID=0
ALERT_COOLDOWN_SECONDS=1800

# --- Retail analytics --------------------------------------------------------
STORE_CAPACITY=50            # max people before congestion hits Critical
STAFFING_THRESHOLD=15        # people count above which missing staff is a gap
CONGESTED_AT=0.6             # congestion index -> "Congested"
CRITICAL_AT=0.9              # congestion index -> "Critical"
LOOP_INTERVAL_SECONDS=60     # main loop period (KB default: 60s)
STATE_POST_INTERVAL_SECONDS=300   # how often telemetry is re-posted when unchanged

# --- Local fallback configuration -------------------------------------------
# Used until the dashboard pushes a set_config envelope. JSON list of cameras:
# [{"id": "cam1", "url": "rtsp://user:pass@host:554/stream", "role": "entrance"}]
LOCAL_CAMERAS=[{"id":"cam1","url":"rtsp://user:pass@192.168.1.64:554/stream1","role":"entrance"}]
# Global instruction for the vision model.
LOCAL_AI_PROMPT=You are a retail CCTV analyst. Describe the scene and count how many people are visible. Reply in strict JSON: {"count": <int>, "staff_present": <bool>, "congestion": "low|medium|high", "summary": "<short>"}

# Subscription firewall: epoch seconds. Default 2100-01-01 means "never expires"
# until the admin dashboard pushes a real subscription_expiry.
DEFAULT_SUBSCRIPTION_EXPIRY=4102444800

# --- Paths -------------------------------------------------------------------
DB_PATH=data/retail_ai.db
SNAPSHOT_DIR=snapshots
MODEL_DIR=models
MODEL_FILE=MiniCPM-V-4_7-1B-Q4_K_M.gguf
MMPROJ_FILE=mmproj-model-f16.gguf
MINICPMV_CLI_PATH=llama.cpp/build/bin/llama-mtmd-cli
LOG_FILE=logs/retail_ai.log
INFERENCE_TIMEOUT_SECONDS=120
